                  </zone>
                  <zone forceUpdate='true' h='11938' id='22' type-v2='text' w='49668' x='49991' y='893'>
                    <formatted-text>
                      <run fontcolor='#555555' fontsize='8'>This visualization represents typical weekday summaries of Caltrans PeMS Data (</run>
                      <run auto-url='true' fontcolor='#555555' fontsize='8' hyperlink='tabdoc:load-url url=&amp;quot;https://pems.dot.ca.gov/&amp;quot;'>https://pems.dot.ca.gov/</run>
                      <run fontcolor='#555555' fontsize='8'>).  For transportation planning purposes, a &quot;typical weekday&quot; is defined as a </run>
                      <run bold='true' fontcolor='#555555' fontsize='8'>Tuesday</run>
                      <run fontcolor='#555555' fontsize='8'>, </run>
                      <run bold='true' fontcolor='#555555' fontsize='8'>Wednesday</run>
                      <run fontcolor='#555555' fontsize='8'>, or </run>
                      <run bold='true' fontcolor='#555555' fontsize='8'>Thursday</run>
                      <run fontcolor='#555555' fontsize='8'> in the months of </run>
                      <run bold='true' fontcolor='#555555' fontsize='8'>March</run>
                      <run fontcolor='#555555' fontsize='8'>, </run>
                      <run bold='true' fontcolor='#555555' fontsize='8'>April</run>
                      <run fontcolor='#555555' fontsize='8'>, </run>
                      <run bold='true' fontcolor='#555555' fontsize='8'>May</run>
                      <run fontcolor='#555555' fontsize='8'>, </run>
                      <run bold='true' fontcolor='#555555' fontsize='8'>September</run>
                      <run fontcolor='#555555' fontsize='8'>, </run>
                      <run bold='true' fontcolor='#555555' fontsize='8'>October</run>
                      <run fontcolor='#555555' fontsize='8'> and </run>
                      <run bold='true' fontcolor='#555555' fontsize='8'>November</run>
                      <run fontcolor='#555555' fontsize='8'>, not including holidays.</run>
                      <run>Æ&#10;&#10;</run>
                      <run fontcolor='#555555' fontsize='8'>Underlying data last updated: </run>
                      <run bold='true' fontcolor='#555555' fontsize='8'>2025-03-16</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#555555' fontsize='8'>Data Files: </run>
                      <run auto-url='true' fontcolor='#555555' fontsize='8' hyperlink='tabdoc:load-url url=&amp;quot;https://mtcdrive.box.com/v/pems-typical-weekday&amp;quot;'>https://mtcdrive.box.com/v/pems-typical-weekday</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#555555' fontsize='8'>Processing Scripts: </run>
                      <run auto-url='true' fontcolor='#555555' fontsize='8' hyperlink='tabdoc:load-url url=&amp;quot;https://github.com/BayAreaMetro/pems-typical-weekday&amp;quot;'>https://github.com/BayAreaMetro/pems-typical-weekday</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                </zone>
              </zone>
            </zone>
          </zone>
