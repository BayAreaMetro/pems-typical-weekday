      <aliases enabled='yes' />
      <column caption='Show Lane Flow' datatype='boolean' name='[Calculation_2048011980128600065]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Station Parameter (copy)_825566156526661632]' />
      </column>
      <column caption='Lanes Parameter' datatype='boolean' name='[Calculation_2048011980135813123]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [lanes]&#13;&#10;    when 2 then [Parameters].[Parameter 2] = True&#13;&#10;end' />
      </column>
      <column caption='First Year' datatype='real' default-format='n0;-0' name='[Calculation_2684426909558722560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Min([year])' />
      </column>
      <column caption='Data Points' datatype='integer' name='[Calculation_2684426909559242754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([avg_flow])' />
      </column>
      <column caption='Type Decoded' datatype='string' name='[Calculation_2684426909559463939]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [type]&#13;&#10;WHEN &apos;CH&apos; THEN &apos;Conventional Highway&apos;&#13;&#10;WHEN &apos;FF&apos; THEN &apos;Freeway-to-freeway&apos;&#13;&#10;WHEN &apos;FR&apos; THEN &apos;Off ramp&apos;&#13;&#10;WHEN &apos;HV&apos; THEN &apos;HOV&apos;&#13;&#10;WHEN &apos;ML&apos; THEN &apos;Mainline&apos;&#13;&#10;WHEN &apos;OR&apos; THEN &apos;On ramp&apos;&#13;&#10;ELSE &apos;unknown&apos;&#13;&#10;END' />
      </column>
      <column caption='Station Description' datatype='string' name='[Calculation_2684426909559697412]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;D&quot; + str([district]) + &quot; &quot; +&#13;&#10;str([station]) + &quot; &quot; + &#13;&#10;str([route]) + &#13;&#10;[direction] + &quot; &quot; + &#13;&#10;[Calculation_2684426909559463939]' />
      </column>
      <column caption='Hour (time)' datatype='datetime' name='[Calculation_2684426909563994117]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MAKETIME(int([hour]),0,0)' />
      </column>
      <column caption='Span of Years Observed' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2684426909566054406]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[First Year (copy)_2684426909558861825]-[Calculation_2684426909558722560]' />
      </column>
      <column caption='Last Year' datatype='real' default-format='n0;-0' name='[First Year (copy)_2684426909558861825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([year])' />
      </column>
      <column caption='Show Lane 6' datatype='boolean' name='[Show Lane 2 FLow (copy)_2048011980351537159]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT(ISNULL({ FIXED [Calculation_2684426909559697412] :max([avg_flow_6])}))' />
      </column>
      <column caption='Show Lane 7' datatype='boolean' name='[Show Lane 6 (copy)_2048011980354039816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT(ISNULL({ FIXED [Calculation_2684426909559697412] :max([avg_flow_7])}))' />
      </column>
      <column caption='Show Lane 5' datatype='boolean' name='[Show Lane Flow (copy)_2048011980343832580]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT(ISNULL({ FIXED [Calculation_2684426909559697412] :max([avg_flow_5])}))' />
      </column>
